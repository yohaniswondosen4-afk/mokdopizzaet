                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl overflow-hidden shadow-md border border-charcoal/10 flex flex-col justify-between hover:shadow-lg transition';
                card.innerHTML = `
                    <div class="h-48 overflow-hidden relative">
                        <img src="${item.img}" alt="${item.name}" class="w-full h-full object-cover hover:scale-105 transition duration-500">
