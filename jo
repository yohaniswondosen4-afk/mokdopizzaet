            });
        }

        function filterMenu(cat) {
            document.querySelectorAll('.menu-category-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            renderMenu(cat);
        }

        function renderToppings() {
            const container = document.getElementById('toppings-container');
            container.innerHTML = '';
            toppingsData.forEach((top, idx) => {
                const div = document.createElement('label');
                div.className = 'flex items-center gap-2 cursor-pointer p-1 hover:bg-white rounded transition';
                div.innerHTML = `
                    <input type="checkbox" value="${top.name}" data-price="${top.price}" onchange="updateTotal()" class="accent-terracotta topping-checkbox">
                    <span class="text-xs">${top.name} (+${top.price} ETB)</span>
                `;
                container.appendChild(div);
            });
        }

        function addToCart(id) {
            const item = menuData.find(i => i.id === id);
            cart.push(item);
            openOrderModal();
        }

        function openOrderModal() {
            document.getElementById('order-modal').classList.remove('hidden');
            updateModalCartDisplay();
        }

        function closeOrderModal() {
            document.getElementById('order-modal').classList.add('hidden');
        }

        function updateModalCartDisplay() {
            const list = document.getElementById('modal-items-list');
            if (cart.length === 0) {
                list.innerHTML = '<p class="text-sm text-charcoal/60">No items selected yet. Choose items from the menu or add extra toppings!</p>';
            } else {
                list.innerHTML = cart.map((item, idx) => `
                    <div class="flex justify-between items-center text-sm bg-white p-2 rounded-lg border border-charcoal/10">
                        <span>${item.name}</span>
                        <div class="flex items-center gap-3">
                            <span class="font-semibold">${item.price} ETB</span>
                            <button onclick="removeFromCart(${idx})" class="text-terracotta hover:text-red-700 font-bold">&times;</button>
                        </div>
                    </div>
                `).join('');
            }
            updateTotal();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateModalCartDisplay();
        }

        function updateTotal() {
            let total = cart.reduce((sum, item) => sum + item.price, 0);
            
            // Add toppings
            document.querySelectorAll('.topping-checkbox:checked').forEach(cb => {
                total += parseInt(cb.getAttribute('data-price'));
            });

            // Add takeaway box
            if (document.getElementById('takeaway-box-check').checked) {
                total += 60;
            }

            document.getElementById('modal-total-price').innerText = total + ' ETB';
        }

        function submitOrder() {
            const name = document.getElementById('cust-name').value.trim();
            const phone = document.getElementById('cust-phone').value.trim();
            const address = document.getElementById('cust-address').value.trim();

            if (!name || !phone) {
                alert('Please enter your Name and Phone Number to place your order.');
                return;
            }

            if (cart.length === 0 && document.querySelectorAll('.topping-checkbox:checked').length === 0) {
                alert('Please select at least one menu item or topping for your order.');
                return;
            }

            const total = document.getElementById('modal-total-price').innerText;
            let orderSummary = `New Order from Mokodo Website!\nName: ${name}\nPhone: ${phone}\nAddress: ${address}\n\nItems:\n`;
            cart.forEach(i => orderSummary += `- ${i.name} (${i.price} ETB)\n`);
            
            const selectedToppings = [];
            document.querySelectorAll('.topping-checkbox:checked').forEach(cb => {
                selectedToppings.push(`${cb.value} (${cb.dataset.price} ETB)`);
            });
            if (selectedToppings.length > 0) {
                orderSummary += `Toppings: ${selectedToppings.join(', ')}\n`;
            }

            if (document.getElementById('takeaway-box-check').checked) {
                orderSummary += `Takeaway Box: Included (60 ETB)\n`;
            }
            orderSummary += `Total: ${total}`;

            // Open WhatsApp direct message to 0911439524
            const whatsappUrl = `https://wa.me/251911439524?text=${encodeURIComponent(orderSummary)}`;
            window.open(whatsappUrl, '_blank');
            closeOrderModal();
        }

        // Initialize on load
        window.onload = () => {
            renderMenu('all');
            renderToppings();
        };
    </script>
</body>
</html>
